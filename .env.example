# ============================================
# DrishtiAI — Environment Configuration
# ============================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Frontend / Vite).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================
# Gemma API Keys (Backend — add as many as you want, the app rotates through them)
# ============================================
GEMMA_API_KEY_1=your_key_here
GEMMA_API_KEY_2=your_key_here
GEMMA_API_KEY_3=your_key_here
GEMMA_API_KEY_4=your_key_here
GEMMA_API_KEY_5=your_key_here
GEMMA_API_KEY_6=your_key_here

# ============================================
# Flask Backend Settings
# ============================================
FLASK_SECRET_KEY=DrishtiAI-secret-key-change-me
FLASK_DEBUG=true
